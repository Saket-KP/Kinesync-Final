# Large, private, or generated. Files are added to this repo explicitly, so this is a
# second line of defence rather than the only one.

# Model weights: 112 MB each, over GitHub's 100 MB hard limit
*.pt
*.ckpt

# The data release: large, not ours to republish, and the lyric text must not be
# published at all (see DATA_CARD.md).
/data/
/data_v2/features/
/data_v2/shots/
/data_v2/lyrics/
/data_v2/masked_lyrics.csv
/data_v2/pending_not_processed.csv
/data_v2/removed_duplicates.csv
*.zip

# Training and evaluation outputs
/runs/
/out/

# Stage 2 generated output: storyboard sheets carry lyric lines
/Stage 2/Kinesync/outputs/
/Stage 2/Kinesync/checkpoints/
/Stage 2/Kinesync/cache/
/Stage 2/Kinesync/stage1/
/Stage 2/Kinesync/stage2/
/Stage 2/Kinesync/uploads/
/Stage 2/Kinesync/results/
/Stage 2/Kinesync/.git_disabled/

# Paper sources and working notes are kept out of this repo by request
/paper/
/labels/
/Sample real-cutlist/

# Local environment
/.claude/
__pycache__/
*.pyc
.pytest_cache/
/.venv/
